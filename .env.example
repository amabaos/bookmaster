# ══════════════════════════════════════════════════════════
#  BotPlatform — переменные окружения
#  Скопируй в .env и заполни значения
# ══════════════════════════════════════════════════════════

# Секрет для шифрования токенов ботов (32 байта base64)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# БД
# Локально:
DATABASE_URL=sqlite+aiosqlite:///./data.db
# Railway (после создания Volume в /data):
# DATABASE_URL=sqlite+aiosqlite:////data/data.db

# Сессии сайта (любая длинная случайная строка)
SECRET_KEY=change_me_to_random_64_chars

# Логин/пароль владельца в админке
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me

# Папка для загрузок (фото, видео, файлы колеса)
# Локально: не задавай (по умолчанию ./uploads)
# Railway: /data/uploads  (Volume примонтирован в /data)
# UPLOAD_DIR=/data/uploads

# Опционально: ограничить доступ к админке по IP
# ALLOWED_IPS=1.2.3.4,5.6.7.8

# ── Webhook (для продакшена) ───────────────────────────────
# Railway автоматически даёт домен вида: https://xxx.up.railway.app
# Раскомментируй и вставь свой Railway-домен:
# WEBHOOK_HOST=https://xxx.up.railway.app
# WEBHOOK_SECRET=придумай_любую_строку_до_256_символов
